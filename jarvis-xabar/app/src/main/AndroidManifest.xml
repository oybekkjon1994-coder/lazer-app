<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="uz.jarvis.MSG" android:protectionLevel="signature" />
    <uses-permission android:name="uz.jarvis.MSG" />
    <queries><package android:name="uz.jarvis.yordamchi" /></queries>
    <application android:label="Jarvis Xabar" android:icon="@drawable/ic" android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".Listener" android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
        <receiver android:name=".Cmd" android:exported="true" android:permission="uz.jarvis.MSG">
            <intent-filter>
                <action android:name="uz.jarvis.REPLY" />
                <action android:name="uz.jarvis.SETTINGS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
